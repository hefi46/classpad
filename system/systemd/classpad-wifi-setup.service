[Unit]
Description=Classpad first-boot interactive WiFi setup
# Runs on the real console (tty1), ahead of LightDM -- see the drop-in at
# system/systemd/lightdm.service.d/classpad-wifi-setup.conf, which is what
# actually makes lightdm.service wait on this rather than relying on
# `Before=` alone (`Before=` orders but does not pull in a dependency).
# Conflicts+After on getty@tty1 hands us the console cleanly instead of
# racing the default agetty for it.
DefaultDependencies=no
Conflicts=getty@tty1.service
After=getty@tty1.service NetworkManager.service systemd-user-sessions.service
Wants=NetworkManager.service
Before=lightdm.service

[Service]
Type=oneshot
RemainAfterExit=yes
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
ExecStart=/opt/classpad/scripts/wifi-setup-interactive.sh

[Install]
WantedBy=multi-user.target
